# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional override. Default is /api/ranking (same-origin).
VITE_RESUME_RANKING_API=/api/ranking

# Logo.dev (real company/school logos on profile + job cards). Free publishable
# key from https://www.logo.dev — safe to expose client-side. Leave unset to
# keep the initials-only fallback.
VITE_LOGO_DEV_PUBLISHABLE_KEY=your_logo_dev_publishable_key

# Mailgun Configuration
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_FROM_EMAIL=your_mailgun_from_email

# AWS Credentials
AWS_REGION=your_region
S3_BUCKET_NAME=your_bucket_name
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_access_key
